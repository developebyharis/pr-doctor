{
  "name": "pointer-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "PR Doctor — IBM BOB 2.0 hackathon monorepo",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter pr-doctor dev",
    "build": "pnpm --filter pr-doctor build",
    "start": "pnpm --filter pr-doctor start",
    "lint": "pnpm --filter pr-doctor lint",
    "validate": "pnpm --filter pr-doctor validate",
    "install:web": "pnpm --filter pr-doctor install",
    "install:api": "pnpm --filter pr-doctor-api install",
    "setup": "pnpm install && pnpm --filter pr-doctor-api install",
    "api:dev": "pnpm --filter pr-doctor-api dev",
    "api:build": "pnpm --filter pr-doctor-api build",
    "api:serve": "pnpm --filter pr-doctor-api serve"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    }
  }
}
