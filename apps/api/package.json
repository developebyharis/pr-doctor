{
  "name": "pr-doctor-api",
  "version": "0.1.0",
  "private": true,
  "description": "PR Doctor – Express + TypeScript ingestion service (port of packages/pr-ingestion)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx src/cli.ts ingest",
    "ingest-open": "tsx src/cli.ts ingest-open",
    "list": "tsx src/cli.ts list",
    "show": "tsx src/cli.ts show"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
